rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Membre du groupe = a un profil dans /users (créé avec le bon code)
    function membre() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Le code du groupe : invisible depuis l'appli
    match /config/{docId} {
      allow read, write: if false;
    }

    // Profils des joueurs
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || membre());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.code == get(/databases/$(database)/documents/config/acces).data.code;
      allow update, delete: if false;
    }

    // Fiches : chacun ne modifie que les siennes (ou une fiche sans propriétaire)
    match /persos/{id} {
      allow read, create: if membre();
      allow update, delete: if membre()
        && (resource.data.ownerId == "" || resource.data.ownerId == request.auth.uid);
    }

    // ---- Messagerie ----
    function mjUid() {
      return get(/databases/$(database)/documents/roles/mj).data.uid;
    }
    function estMJ() {
      return exists(/databases/$(database)/documents/roles/mj) && mjUid() == request.auth.uid;
    }

    // Qui est le MJ : le premier qui se déclare, puis seul le MJ peut passer la main
    match /roles/mj {
      allow read: if membre();
      allow create: if membre() && request.resource.data.uid == request.auth.uid;
      allow update: if membre() && resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.uid));
      allow delete: if false;
    }

    // Duos de joueurs autorisés à s'écrire : seul le MJ décide
    match /roles/messagerie {
      allow read: if membre();
      allow write: if membre() && estMJ();
    }

    // Messages : lisibles uniquement par les deux personnes de la discussion
    match /messages/{id} {
      allow read: if membre() && request.auth.uid in resource.data.p;
      allow create: if membre()
        && request.resource.data.de == request.auth.uid
        && request.resource.data.a != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.a))
        && request.resource.data.p.size() == 2
        && request.resource.data.p.hasAll([request.resource.data.de, request.resource.data.a])
        && request.resource.data.conv in [request.resource.data.de + '_' + request.resource.data.a, request.resource.data.a + '_' + request.resource.data.de]
        && request.resource.data.texte is string
        && request.resource.data.texte.size() > 0 && request.resource.data.texte.size() <= 2000
        && (estMJ()
            || (exists(/databases/$(database)/documents/roles/mj) && mjUid() == request.resource.data.a)
            || (exists(/databases/$(database)/documents/roles/messagerie)
                && request.resource.data.conv in get(/databases/$(database)/documents/roles/messagerie).data.paires));
      allow update: if false;
      // chacun peut effacer les messages des discussions dont il fait partie (fin de campagne, effacer une discussion)
      allow delete: if membre() && request.auth.uid in resource.data.p;
    }

    // Données communes du groupe
    match /{col}/{id} {
      allow read, write: if membre()
        && col in ['biblio', 'sessions', 'courses', 'commun', 'groupe'];
    }
  }
}
